{
  "expo": {
    "name": "PJ1 GIGBASE",
    "slug": "pj1-gigbase",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "pj1gigbase",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pj1gigbase.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pj1gigbase.app",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#010425",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010425",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-router",
      [
  "expo-build-properties",
  {
    "android": {
      "enableMinifyInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    }
  }
],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload and share them on our app"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      "expo-video",
      "@react-native-community/datetimepicker"
    
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e80c4e53-e207-4929-a571-344f444ed17d"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000,
      "url": "https://u.expo.dev/e80c4e53-e207-4929-a571-344f444ed17d"
    },
    "owner": "chikagod"
  }
}
